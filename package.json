{
  "name": "scriptable-codex-usage",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs server/test/*.test.mjs",
    "test:widget": "node --test tests/*.test.mjs",
    "test:server": "node --test server/test/*.test.mjs",
    "start:server": "node server/src/server.mjs",
    "preview": "node scripts/preview.mjs",
    "release": "node scripts/release.mjs",
    "check:release": "node scripts/release.mjs --check"
  }
}
